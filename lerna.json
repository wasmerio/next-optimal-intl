{
  "$schema": "node_modules/@lerna-lite/cli/schemas/lerna-schema.json",
  "version": "5.0.0",
  "packages": [
    "packages/next-intl"
  ],
  "npmClient": "pnpm",
  "changelogPreset": "conventional-changelog-conventionalcommits",
  "command": {
    "publish": {
      "removePackageFields": [
        "devDependencies",
        "prettier"
      ],
      "yes": true
    },
    "version": {
      "conventionalCommits": true
    }
  }
}
